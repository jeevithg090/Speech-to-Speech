# Copy to .env and adjust. All variables are optional.

# --- Demo servers (scripts/*_demo.py, scripts/piper_tts_server.py) ---
# Interface to bind. Use 0.0.0.0 to expose on your network (e.g. inside Docker).
APOLLO_HOST=127.0.0.1
# Port override (defaults: api_demo/speech_demo 8000, unified_demo 6969, piper 8085)
# APOLLO_PORT=8000
# Comma-separated list of allowed CORS origins ("*" allows any origin)
APOLLO_CORS_ORIGINS=*
# Upload / input limits
APOLLO_MAX_UPLOAD_MB=10
APOLLO_MAX_TEXT_CHARS=2000

# --- Models ---
# Whisper model size for scripts/speech_demo.py (tiny, base, small, medium, large)
APOLLO_WHISPER_MODEL=small
# Hugging Face access token (only needed for gated/private models). Keep secret.
HF_TOKEN=
# Directory containing Piper .onnx voices
# PIPER_VOICE_DIR=~/.local/share/piper_voices

# --- Notebooks (Colab + ngrok tunnel) ---
# Get one at https://dashboard.ngrok.com. Keep secret.
NGROK_AUTH_TOKEN=
